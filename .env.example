# Copy to .env (or export these) before running the server.

# The device's address. Stock firmware serves plain HTTP on the LAN;
# if you've enabled TLS on the device (Settings → Advanced), use https://.
JETKVM_URL=http://192.168.1.50

# Local auth password. Leave empty if the device is in noPassword mode.
JETKVM_PASSWORD=

# Set true only if the device has a certificate your system trusts.
JETKVM_VERIFY_TLS=false
